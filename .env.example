# ==============================================================================
# ScoutAI Environment Configuration
# ==============================================================================

# Core Gemini LLM Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Standalone Offline Demo Mode (Replays pre-recorded BitDelta run without needing API keys)
DEMO_MODE=true

# Web Search Provider: 'ddg' (free DuckDuckGo, default) or 'tavily'
SEARCH_PROVIDER=ddg
TAVILY_API_KEY=

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=scoutai

# Server & Security Settings
PORT=8000
DATABASE_URL=sqlite:///./scoutai.db
CHROMA_PERSIST_DIRECTORY=./chroma_data
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_AGENT_CYCLES=2
